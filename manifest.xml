/* global Office, Excel, Word, console */

let HOST_APP = ""; // "Excel" hoặc "Word"

Office.onReady((info) => {
    if (info.host === Office.HostType.Excel) {
        HOST_APP = "Excel";
        console.log("EXAI - Excel sẵn sàng.");
    } else if (info.host === Office.HostType.Word) {
        HOST_APP = "Word";
        console.log("EXAI - Word sẵn sàng.");
        // Đổi placeholder cho phù hợp Word
        const promptEl = document.getElementById("prompt_input");
        if (promptEl) {
            promptEl.placeholder = "VD: Viết đoạn văn giới thiệu công ty\nVD: Sửa lỗi chính tả đoạn đang chọn\nVD: Dịch đoạn chọn sang tiếng Anh\nVD: Tóm tắt văn bản đang chọn\nVD: Viết email xin nghỉ phép";
        }
    }

    document.getElementById("run_button").onclick = executeCommand;
    document.getElementById("clear_button").onclick = clearAll;

    const savedKey = localStorage.getItem("gemini_api_key");
    if (savedKey) document.getElementById("api_key_input").value = savedKey;
    const savedModel = localStorage.getItem("gemini_model");
    if (savedModel) document.getElementById("model_select").value = savedModel;
});

function setStatus(message, type) {
    const el = document.getElementById("status_area");
    el.className = "status " + type;
    el.innerText = message;
}

// Gọi Gemini
async function callGemini(apiKey, model, prompt) {
    const response = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}`,
        {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: { temperature: 0.3, maxOutputTokens: 4096 }
            })
        }
    );
    const data = await response.json();
    if (!response.ok) throw new Error(data.error?.message || "Lỗi API");
    if (!data.candidates || data.candidates.length === 0) throw new Error("Không nhận được phản hồi.");
    return data.candidates[0].content.parts.map(p => p.text).join(" ").trim();
}

function cleanCode(code) {
    code = code.replace(/```javascript/gi, "").replace(/```js/gi, "").replace(/```/g, "").trim();
    code = code.replace(/^[\s\S]*?await\s+Excel\.run\s*\(\s*async\s*\([^)]*\)\s*=>\s*\{/i, "");
    code = code.replace(/^[\s\S]*?await\s+Word\.run\s*\(\s*async\s*\([^)]*\)\s*=>\s*\{/i, "");
    code = code.replace(/await\s+context\.sync\(\)\s*;?\s*\}\s*\)\s*;?\s*$/i, "");
    code = code.trim();
    return code;
}

// ============ XỬ LÝ EXCEL ============
async function getExcelContext() {
    let info = "";
    await Excel.run(async (context) => {
        const selected = context.workbook.getSelectedRange();
        selected.load("address, values");
        const used = context.workbook.worksheets.getActiveWorksheet().getUsedRangeOrNullObject();
        used.load("address, text");
        await context.sync();
        info += `Vùng đang chọn: ${selected.address}\n`;
        info += `Dữ liệu vùng chọn: ${JSON.stringify(selected.values)}\n`;
        if (!used.isNullObject) {
            info += `Vùng có dữ liệu: ${used.address}\n`;
            info += `Xem trước:\n${used.text.slice(0, 30).map(r => r.join(" | ")).join("\n")}\n`;
        }
    });
    return info;
}

async function runExcelCode(code) {
    await Excel.run(async (context) => {
        const sheet = context.workbook.worksheets.getActiveWorksheet();
        const workbook = context.workbook;
        const runner = new Function("context", "sheet", "workbook", "Excel",
            `return (async () => { ${code} \n await context.sync(); })();`);
        await runner(context, sheet, workbook, Excel);
        await context.sync();
    });
}

// ============ XỬ LÝ WORD ============
async function getWordContext() {
    let info = "";
    await Word.run(async (context) => {
        const selection = context.document.getSelection();
        selection.load("text");
        await context.sync();
        info += `Văn bản người dùng ĐANG CHỌN (bôi đen): "${selection.text}"\n`;
    });
    return info;
}

async function runWordCode(code) {
    await Word.run(async (context) => {
        const doc = context.document;
        const selection = context.document.getSelection();
        const body = context.document.body;
        const runner = new Function("context", "doc", "selection", "body", "Word",
            `return (async () => { ${code} \n await context.sync(); })();`);
        await runner(context, doc, selection, body, Word);
        await context.sync();
    });
}

// System prompt cho EXCEL
const EXCEL_RULES = `Bạn là chuyên gia Office.js điều khiển Excel.
CHỈ trả về code JavaScript thuần (không markdown, không backtick, không giải thích).
Code chạy trong: await Excel.run(async (context) => { [CODE] await context.sync(); });
Biến có sẵn: context, sheet, workbook, Excel.
- Vùng chọn: workbook.getSelectedRange()
- Ô cụ thể: sheet.getRange("D3")
- Đọc: range.load("values"); await context.sync(); rồi dùng range.values
- Ghi giá trị: range.values = [[...]]; Công thức: range.formulas = [["=..."]];
- Font: range.format.font.name/.size/.bold/.color; Nền: range.format.fill.color
- Sắp xếp: range.sort.apply([{key:0, ascending:true}]);
Logic phức tạp: đọc values vào JS, xử lý, ghi ra range bằng getResizedRange(n-1, m-1).`;

// System prompt cho WORD
const WORD_RULES = `Bạn là chuyên gia Office.js điều khiển Microsoft Word.
CHỈ trả về code JavaScript thuần (không markdown, không backtick, không giải thích).
Code chạy trong: await Word.run(async (context) => { [CODE] await context.sync(); });
Biến có sẵn: context, doc, selection (vùng đang chọn), body (toàn bộ văn bản), Word.

CÁCH DÙNG:
- Đọc văn bản đang chọn: selection.load("text"); await context.sync(); rồi selection.text
- Thay thế văn bản đang chọn: selection.insertText("nội dung mới", Word.InsertLocation.replace);
- Chèn vào cuối tài liệu: body.insertParagraph("nội dung", Word.InsertLocation.end);
- Chèn sau vị trí chọn: selection.insertText("...", Word.InsertLocation.after);
- Định dạng: selection.font.name = "Times New Roman"; selection.font.size = 13; selection.font.bold = true; selection.font.color = "#FF0000";
- Căn lề: selection.paragraphs.getFirst().alignment = Word.Alignment.centered;
- In nghiêng: selection.font.italic = true;

VÍ DỤ - "Viết đoạn văn giới thiệu công ty":
body.insertParagraph("Công ty chúng tôi...", Word.InsertLocation.end);

VÍ DỤ - "Dịch đoạn đang chọn sang tiếng Anh":
Bạn tự dịch nội dung, rồi:
selection.insertText("[bản dịch tiếng Anh]", Word.InsertLocation.replace);

QUAN TRỌNG: Nếu yêu cầu là VIẾT/SỬA/DỊCH/TÓM TẮT nội dung, bạn phải tự tạo ra nội dung văn bản hoàn chỉnh (tiếng Việt hoặc theo yêu cầu) rồi chèn vào, KHÔNG để placeholder.`;

async function executeCommand() {
    const apiKey = document.getElementById("api_key_input").value.trim();
    const model = document.getElementById("model_select").value;
    const userPrompt = document.getElementById("prompt_input").value.trim();
    const btn = document.getElementById("run_button");

    if (!apiKey) { setStatus("⚠️ Vui lòng nhập API key.", "error"); return; }
    if (!userPrompt) { setStatus("⚠️ Vui lòng nhập yêu cầu.", "error"); return; }

    localStorage.setItem("gemini_api_key", apiKey);
    localStorage.setItem("gemini_model", model);
    btn.disabled = true;
    setStatus("⏳ Đang phân tích...", "loading");

    try {
        let contextInfo, rules, runFunc;
        if (HOST_APP === "Excel") {
            contextInfo = await getExcelContext();
            rules = EXCEL_RULES;
            runFunc = runExcelCode;
        } else if (HOST_APP === "Word") {
            contextInfo = await getWordContext();
            rules = WORD_RULES;
            runFunc = runWordCode;
        } else {
            throw new Error("Không nhận diện được ứng dụng.");
        }

        const fullPrompt = `${rules}\n\nBỐI CẢNH HIỆN TẠI:\n${contextInfo}\n\nYÊU CẦU: ${userPrompt}`;
        let code = await callGemini(apiKey, model, fullPrompt);
        code = cleanCode(code);
        console.log("=== Code AI (" + HOST_APP + ") ===\n", code);

        try {
            setStatus("⚙️ Đang thực thi...", "loading");
            await runFunc(code);
            setStatus("✅ Đã thực thi thành công!", "success");
        } catch (execError) {
            setStatus("🔄 Gặp lỗi, đang tự sửa...", "loading");
            const fixPrompt = `${rules}\n\nBỐI CẢNH:\n${contextInfo}\n\nYÊU CẦU: ${userPrompt}\n\nCode lỗi:\n${code}\n\nLỖI: ${execError.message}\n\nViết lại code ĐÚNG. Chỉ trả về code.`;
            let fixedCode = cleanCode(await callGemini(apiKey, model, fixPrompt));
            console.log("=== Code sửa lại ===\n", fixedCode);
            await runFunc(fixedCode);
            setStatus("✅ Đã thực thi thành công (sau khi tự sửa)!", "success");
        }

    } catch (error) {
        console.error(error);
        setStatus("❌ Lỗi: " + error.message, "error");
    } finally {
        btn.disabled = false;
    }
}

function clearAll() {
    document.getElementById("prompt_input").value = "";
    document.getElementById("status_area").className = "status";
    document.getElementById("status_area").innerText = "";
}